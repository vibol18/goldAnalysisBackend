# GoldSight backend environment. Copy to `.env` and fill in values.

# --- Server and persistence ---
ENV=development
PORT=8000
APP_VERSION=1.0.0
DATABASE_URL=
# Comma-separated frontend origins; these are the development defaults.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Render's internal PostgreSQL URL is supplied as DATABASE_URL.

# --- LLM (swappable: anthropic | openai | none) ---
LLM_PROVIDER=none
LLM_API_KEY=
# optional model override (defaults: claude-sonnet-4-20250514 / gpt-4o-mini)
LLM_MODEL=

# --- Market data: real XAU/USD only (never synthetic) ---
# Free key from https://twelvedata.com — highest priority source (symbol XAU/USD).
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOL=XAU/USD
GOLD_API_BASE_URL=https://api.gold-api.com
# Keyless real gold candles (1 XAUT token = 1 troy oz) used when the above are blocked.
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_GOLD_PAIR=XAUTUSD
# Yahoo Finance fallbacks, tried in order when Twelve Data is absent/rate-limited.
GOLD_TICKER=XAUUSD=X
GOLD_FALLBACK_TICKER=GC=F

# --- Cache TTLs (seconds) ---
CACHE_TTL_INTRADAY=60
CACHE_TTL_DAILY=1800

# --- Signal engine ---
ML_HORIZON=6
SIGNAL_BUY_THRESHOLD=0.22
SIGNAL_SELL_THRESHOLD=-0.22
SIGNAL_COOLDOWN_MINUTES=45
ATR_STOP_MULT=1.5

# --- Alerts (optional; secrets stay in this file) ---
TELEGRAM_BOT_TOKEN=
# Legacy single-chat notification target. The bot now uses /start subscribers instead.
TELEGRAM_CHAT_ID=

# --- Telegram bot (per-user subscribers, commands and webhook) ---
# Local mode (ENV=development) uses long polling and deletes any webhook on startup.
# Render mode (ENV=production) registers a webhook and verifies this secret header.
TELEGRAM_WEBHOOK_SECRET=
# Public backend URL used for the webhook; on Render this defaults to https://RENDER_EXTERNAL_HOSTNAME.
PUBLIC_BASE_URL=
# Comma-separated Telegram chat IDs allowed to use admin commands (/broadcast, /users, /status).
ADMIN_CHAT_IDS=
# Generated on the Settings page and given to the bot with /link <code> (10 minute expiry).
TELEGRAM_LINK_CODE_TTL_SECONDS=600
TELEGRAM_DAILY_CAP=50
TELEGRAM_RATE_PER_SECOND=25
TELEGRAM_PER_CHAT_SECONDS=1
TELEGRAM_CATCHUP_ENABLED=1

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Shared realtime stream (seconds) ---
STREAM_INTERVAL_SECONDS=2
TP1_ATR_MULT=1.5
TP2_ATR_MULT=3.0

# --- Backtest assumptions ---
SPREAD_USD=0.30
COMMISSION_USD=0.00
BACKTEST_YEARS=5
RISK_FREE_RATE=0.04

# --- Storage ---
# DB_PATH=C:\path\to\goldsight.db   (defaults to backend/goldsight.db)

# --- Security: authentication (REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS_MINIMUM
JWT_ISSUER=goldsight
JWT_AUDIENCE=goldsight-app
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma-separated real frontend origins, no wildcards
# ALLOWED_ORIGINS is still accepted as a legacy alias.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Legacy compatibility; ENV=production is preferred.
PRODUCTION=0
# Optional values default to cross-site Secure cookies in production and local Lax cookies.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=1
# TRUSTED_HOSTS=*.onrender.com
# Optional TOTP / email verification encryption key (separate random secret)
FIELD_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_RANDOM_48_CHARS

# --- Security: risk and abuse limits ---
DAILY_LOSS_LIMIT_PCT=3.0
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=10
