# GoldSight backend environment. Copy to `.env` and fill in values.

# --- LLM (swappable: anthropic | openai | none) ---
LLM_PROVIDER=none
LLM_API_KEY=
# optional model override (defaults: claude-sonnet-4-20250514 / gpt-4o-mini)
LLM_MODEL=

# --- Market data: real XAU/USD only (never synthetic) ---
# Free key from https://twelvedata.com — highest priority source (symbol XAU/USD).
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOL=XAU/USD
GOLD_API_BASE_URL=https://api.gold-api.com
# Keyless real gold candles (1 XAUT token = 1 troy oz) used when the above are blocked.
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_GOLD_PAIR=XAUTUSD
# Yahoo Finance fallbacks, tried in order when Twelve Data is absent/rate-limited.
GOLD_TICKER=XAUUSD=X
GOLD_FALLBACK_TICKER=GC=F

# --- Cache TTLs (seconds) ---
CACHE_TTL_INTRADAY=60
CACHE_TTL_DAILY=1800

# --- Signal engine ---
ML_HORIZON=6
SIGNAL_BUY_THRESHOLD=0.22
SIGNAL_SELL_THRESHOLD=-0.22
SIGNAL_COOLDOWN_MINUTES=45
ATR_STOP_MULT=1.5

# --- Alerts (optional; secrets stay in this file) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Shared realtime stream (seconds) ---
STREAM_INTERVAL_SECONDS=2
TP1_ATR_MULT=1.5
TP2_ATR_MULT=3.0

# --- Backtest assumptions ---
SPREAD_USD=0.30
COMMISSION_USD=0.00
BACKTEST_YEARS=5
RISK_FREE_RATE=0.04

# --- Storage ---
# DB_PATH=C:\path\to\goldsight.db   (defaults to backend/goldsight.db)

# --- Security: authentication (REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS_MINIMUM
JWT_ISSUER=goldsight
JWT_AUDIENCE=goldsight-app
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma-separated real frontend origins, no wildcards
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 in production: disables docs, enforces secure cookies and secret checks
PRODUCTION=0
# Optional TOTP / email verification encryption key (separate random secret)
FIELD_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_RANDOM_48_CHARS

# --- Security: risk and abuse limits ---
DAILY_LOSS_LIMIT_PCT=3.0
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=10
